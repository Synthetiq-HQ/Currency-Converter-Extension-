{
  "manifest_version": 3,
  "minimum_chrome_version": "110",
  "name": "QuickCurrency",
  "version": "1.2.0",
  "description": "Convert selected prices or type an amount. Fast currency conversion with optional highlighting on websites you choose.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.frankfurter.dev/*",
    "https://open.er-api.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuickCurrency \u2014 by Synthetiq",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Open QuickCurrency"
    }
  }
}
